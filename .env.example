# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY

PORT=8787
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGIN=*

# Gemini primary
GEMINI_MODEL=gemini-2.5-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# TokenRa fallback / alternate provider
# Verify current base URL and exact enabled model IDs in your TokenRa console.
TOKENRA_API_KEY=""
TOKENRA_BASE_URL=https://tokenra.io/v1
TOKENRA_MODEL=""

# Comma-separated ordered fallback model IDs. Leave blank to use registry.
TOKENRA_FALLBACK_MODELS=""

# Routing
PRIMARY_PROVIDER=gemini
AUTO_FAILOVER=true
MAX_RETRIES_PER_PROVIDER=1
REQUEST_TIMEOUT_MS=60000
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_OPEN_MS=60000

# Defaults
DEFAULT_TEMPERATURE=0.2
DEFAULT_MAX_OUTPUT_TOKENS=4096
MAX_HISTORY_MESSAGES=30
MAX_CONTEXT_CHARS=120000

# Optional internal access key for your own API
JARVIS_API_KEY=""

# Conservative request budget per task. 0 = disabled.
MAX_PROVIDER_CALLS_PER_TASK=6
